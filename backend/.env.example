# Flask
FLASK_APP=app
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-string
JWT_SECRET_KEY=change-this-to-another-secure-string

# Database
DATABASE_URL=postgresql://aypa:password@localhost:5432/aypa_taxai
REDIS_URL=redis://localhost:6379/0

# AI / LLM
GOOGLE_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=your-openai-api-key-fallback

# Storage
S3_BUCKET=aypa-taxai-documents
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=ap-south-1

# Email
SENDGRID_API_KEY=your-sendgrid-key
FROM_EMAIL=noreply@aypa.taxai

# Payment
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret

# GST Portal / CAPTCHA
TWOCAPTCHA_API_KEY=your-2captcha-key

# Monitoring
SENTRY_DSN=your-sentry-dsn

# Rate Limiting
RATELIMIT_STORAGE_URI=redis://localhost:6379/1
