# =============================================================================
# Aypa TaxAI - Frontend Dockerfile
# Multi-stage build for Next.js frontend application
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Dependencies - install node modules
# ---------------------------------------------------------------------------
FROM node:20-alpine AS deps

WORKDIR /app

# Install libc6-compat for Alpine compatibility with some npm packages
RUN apk add --no-cache libc6-compat

# Copy package files for dependency installation
COPY package.json package-lock.json* yarn.lock* pnpm-lock.yaml* ./

# Install dependencies based on the available lock file
RUN \
    if [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci; \
    elif [ -f pnpm-lock.yaml ]; then corepack enable pnpm && pnpm install --frozen-lockfile; \
    else npm install; \
    fi

# ---------------------------------------------------------------------------
# Stage 2: Builder - build the Next.js application
# ---------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy application source
COPY . .

# Set build-time environment variables
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build the Next.js application
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 3: Production - minimal runtime image
# ---------------------------------------------------------------------------
FROM node:20-alpine AS production

# Metadata
LABEL maintainer="Aypa TaxAI Team <dev@aypa.ai>"
LABEL description="Aypa TaxAI Next.js Frontend"
LABEL version="1.0.0"

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Create non-root user
RUN addgroup --system --gid 1001 aypa && \
    adduser --system --uid 1001 aypa

# Set environment variables
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME="0.0.0.0"

# Copy built application from builder stage
# Next.js standalone output (if configured in next.config.js)
COPY --from=builder /app/public ./public
COPY --from=builder --chown=aypa:aypa /app/.next/standalone ./
COPY --from=builder --chown=aypa:aypa /app/.next/static ./.next/static

# Fallback: if not using standalone, copy the full build
COPY --from=builder --chown=aypa:aypa /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Switch to non-root user
USER aypa

# Expose application port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Start Next.js in production mode
CMD ["npm", "run", "start"]
