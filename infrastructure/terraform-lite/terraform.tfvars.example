# =============================================================================
# Aypa TaxAI - Terraform Variables (FREE TIER Setup)
# Copy this to terraform.tfvars and fill in your values
# =============================================================================

aws_region    = "ap-south-1"    # Mumbai - closest to India
instance_type = "t2.micro"      # FREE TIER: 1 vCPU, 1 GB RAM, 750 hrs/month
                                # Upgrade to "t3.small" (~$15/month) for better performance
volume_size   = 30              # FREE TIER: up to 30 GB gp2/gp3

# Security: Set to your IP for SSH access (e.g., ["1.2.3.4/32"])
# Find your IP: curl ifconfig.me
ssh_allowed_cidrs = ["0.0.0.0/0"]

# Domain (optional - leave empty to use public IP)
app_domain = ""

# =============================================================================
# SECRETS - Generate secure random strings for these
# You can use: openssl rand -hex 32
# =============================================================================

postgres_password = "CHANGE-ME-to-secure-password-123"
secret_key        = "CHANGE-ME-generate-with-openssl-rand-hex-32"
jwt_secret_key    = "CHANGE-ME-generate-with-openssl-rand-hex-32"
google_api_key    = ""   # Get from https://aistudio.google.com/apikey
